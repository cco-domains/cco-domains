  "rdfs:label": {
    "@language": "en",
    "@value": "Agent Capability"
  },
  "rdfs:subClassOf": {
    "@id": "obo:BFO_0000017"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "A Realizable Entity that inheres in a Material Entity in virtue of that Material Entity's capacity to realize it in some Planned Act."
  }
