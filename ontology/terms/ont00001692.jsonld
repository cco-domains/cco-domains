  "rdfs:label": {
    "@language": "en",
    "@value": "Unix Time"
  },
  "skos:scopeNote": {
    "@language": "en",
    "@value": "Unix Time is a Temporal Reference System for describing a point in time, defined as the number of seconds that have elapsed since 00:00:00 Coordinated Universal Time (UTC) Thursday, 1 January 1970 minus the number of leap seconds that have taken place since then.\n(See: https://en.wikipedia.org/wiki/Unix_time)"
  }
