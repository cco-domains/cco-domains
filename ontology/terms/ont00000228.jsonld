  },
  "rdfs:label": {
    "@language": "en",
    "@value": "Planned Act"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ont00000005"
  },
  "skos:altLabel": {
    "@language": "en",
    "@value": "Intentional Act"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "An Act in which at least one Agent plays a causative role and which is prescribed by some Prescriptive Information Content Entity held by at least one of the Agents."
