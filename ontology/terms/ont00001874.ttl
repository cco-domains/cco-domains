@prefix cco: <https://w3id.org/cco-domains/cco/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cco:ont00001874 a owl:ObjectProperty ;
    rdfs:label "is temporal region of"@en ;
    rdfs:domain obo:BFO_0000008 ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( obo:BFO_0000015 obo:BFO_0000035 ) ] ;
    skos:definition "x is temporal region of y =Def y occupies temporal region x"@en ;
    skos:editorialNote "Leaving this is in ERO for now since BFO2020 has no inverse of occupies-temporal-region yet."@en ;
    cco:ont00001760 "https://w3id.org/cco-domains/cco/ExtendedRelationOntology"^^xsd:anyURI .

