    "@value": "https://w3id.org/cco-domains/cco/EventOntology"
  },
  "rdfs:label": {
    "@language": "en",
    "@value": "Radio Interference"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ont00000007"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "A Natural Process in which a radio signal is disrupted, whether unintentionally or as the result of an Act of Radio Jamming, Act of Radio Spoofing, or similar Planned Act."
  }
