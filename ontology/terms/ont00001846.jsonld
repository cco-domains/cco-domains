  "@id": "cco:ont00001846",
  "@type": "owl:ObjectProperty",
  "cco:ont00001760": {
    "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value": "https://w3id.org/cco-domains/cco/AgentOntology"
  },
  "owl:inverseOf": {
    "@id": "cco:ont00001992"
  },
  "rdfs:domain": {
    "@id": "cco:ont00001180"
  },
  "rdfs:label": {
    "@language": "en",
    "@value": "is organizational context of"
  },
  "rdfs:range": {
    "@id": "obo:BFO_0000023"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "x is_organizational_context_of y iff x is an instance of an Organization and y is an instance of a Role and z is an instance of a Person, such that z's affiliation with x is a prerequisite for z bearing y, or x ascribes y to the bearer of y."
  }
}
