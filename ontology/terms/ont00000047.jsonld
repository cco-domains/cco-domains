  "rdfs:label": {
    "@language": "en",
    "@value": "Flow Control Valve"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ont00000598"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "A Valve that is designed to regulate the flow or Pressure of a fluid."
  },
  "skos:scopeNote": {
    "@language": "en",
    "@value": "Flow Control Valves are often more complex than a simple Valve and typically include an Actuator that is capable of automatically adjusting the state of the valve in response to signals from a connected Sensor or Controller."
  }
