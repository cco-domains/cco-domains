  "skos:definition": {
    "@language": "en",
    "@value": "A Process Profile that is the integral of a Force that is applied to a portion of matter over a period of time."
  },
  "skos:scopeNote": {
    "@language": "en",
    "@value": "An Impulse changes the Momentum (and potentially also the direction of Motion) of the object it is applied to and is typically measured in Newton meters."
  }
