  "@id": "cco:ont00000683",
  "@type": "owl:Class",
  "cco:ont00001760": {
    "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value": "https://w3id.org/cco-domains/cco/InformationEntityOntology"
  },
  "rdfs:label": {
    "@language": "en",
    "@value": "Diminutive Name"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ont00000605"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "An Abbreviated Name that is a familiar form of a Proper Name."
  },
  "skos:example": "Alex, Bob, Cathy",
  "skos:scopeNote": {
    "@language": "en",
    "@value": "\"Familiar form of a Proper Name\" means: that the name is (originally) a short, affectionate version of the fuller name, used (originally) by family or friends."
  }
}
