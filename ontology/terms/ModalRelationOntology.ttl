@prefix cco: <https://w3id.org/cco-domains/cco/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

cco:ModalRelationOntology a owl:Ontology ;
    rdfs:label "Modal Relation Ontology" ;
    dcterms:license "BSD 3-Clause: https://github.com/CommonCoreOntology/CommonCoreOntologies/blob/master/LICENSE"@en ;
    dcterms:rights "CUBRC Inc., see full license."@en ;
    rdfs:comment "The modal counterparts to the object and data properties contained in CCO and BFO2020-core." ;
    owl:versionIRI <https://w3id.org/cco-domains/cco/2024-11-06/ModalRelationOntology> ;
    owl:versionInfo "Adapted from open-source CCO extension module (NCOR), version 2.0; IRIs re-based to w3id.org/cco-domains, redirectable to an IEEE-hosted platform for OSWG contribution"@en .

