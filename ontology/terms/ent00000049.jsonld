{
  "@context": {
    "cco": "https://w3id.org/cco-domains/cco/",
    "dcterms": "http://purl.org/dc/terms/",
    "obo": "http://purl.obolibrary.org/obo/",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "skos": "http://www.w3.org/2004/02/skos/core#"
  },
  "@id": "cco:ent00000049",
  "@type": "owl:Class",
  "cco:ent00000019": {
    "@language": "en",
    "@value": "A future Financial domain ontology (IEEE P3195.1.x)"
  },
  "cco:ent00000020": {
    "@language": "en",
    "@value": "No CCO mid-level payment card class exists. Staging pending financial domain ontology formation."
  },
  "cco:ent00000022": {
    "@language": "en",
    "@value": "Proposed to Financial Domain Ontology WG when formed 2026-Q4"
  },
  "dcterms:created": {
    "@type": "http://www.w3.org/2001/XMLSchema#date",
    "@value": "2026-03-17"
  },
  "http://purl.org/dc/elements/1.1/creator": {
    "@language": "en",
    "@value": "Global Research, Inc."
  },
  "rdfs:isDefinedBy": {
    "@id": "https://w3id.org/cco-domains/domains/StagingOntology"
  },
  "rdfs:label": {
    "@language": "en",
    "@value": "Payment Card"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ont00000938"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "A Financial Artifact Function that is a physical or virtual \n        card used to authorize payment transactions, either by drawing on a line of \n        credit or on funds held in a linked account."
  },
  "skos:exactMatch": {
    "@id": "https://schema.org/PaymentCard"
  },
  "skos:example": {
    "@language": "en",
    "@value": "A Visa credit card and a Chase debit card are both Payment Cards."
  },
  "skos:scopeNote": {
    "@language": "en",
    "@value": "PaymentCard is a superclass covering all card-based payment instruments. \n        Subclasses distinguish credit-based (CreditCard) from account-based (DebitCard) \n        instruments. A PaymentCard is identified by a CreditCardNumber, secured by a CVV, \n        and has an ExpirationDateIdentifier. \n        Data models: Schema.org (PaymentCard), MyDex (Dataset: Credit Card), \n        Mee Foundation Requirements (Credit Card), Orphan-Ontology-Dev — 4+ sources."
  }
}
