  "rdfs:label": {
    "@language": "en",
    "@value": "Telecommunication Network Identifier"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ont00000686"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "A Designative Information Content Entity that uniquely identifies \n        a Telecommunication Network or some set of information inhering in such a network, \n        often for the purpose of exchanging information with the identified entity."
  },
  "skos:exactMatch": {
    "@id": "http://www.ontologyrepository.com/CommonCoreOntologies/TelecommunicationNetworkIdentifier"
  },
  "skos:scopeNote": {
    "@language": "en",
    "@value": "Superclass of TelephoneNumber (ent00000023) and EmailAddress (ent00000024). \n        Migrated from Orphan-Ontology-Dev to provide the correct parent class."
  }
