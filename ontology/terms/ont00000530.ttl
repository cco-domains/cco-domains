@prefix cco: <https://w3id.org/cco-domains/cco/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cco:ont00000530 a owl:Class ;
    rdfs:label "Sonic Frequency"@en ;
    rdfs:subClassOf cco:ont00000008 ;
    skos:altLabel "Audible Frequency"@en ;
    skos:definition "A Sound Frequency that is between 20 Hz and 20 kHz."@en ;
    skos:scopeNote "Sound waves with frequencies in this range are typically audible to humans."@en ;
    cco:ont00001760 "https://w3id.org/cco-domains/cco/EventOntology"^^xsd:anyURI .

