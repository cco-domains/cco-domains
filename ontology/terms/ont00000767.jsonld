    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "skos": "http://www.w3.org/2004/02/skos/core#"
  },
  "@id": "cco:ont00000767",
  "@type": "owl:Class",
  "cco:ont00001760": {
    "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value": "https://w3id.org/cco-domains/cco/ArtifactOntology"
  },
  "rdfs:label": {
    "@language": "en",
    "@value": "Lubrication System"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ont00000995"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "A Material Artifact that is designed to contain, transfer, and regulate the flow of lubricant to multiple locations in a Material Artifact."
  },
  "skos:scopeNote": {
    "@language": "en",
    "@value": "A Lubrication System typical consists of a reservoir, pump, heat exchanger, filter, regulator, valves, sensors, pipes, and hoses. In some cases it also includes the passageways and openings within the artifact it is designed to lubricate. For example, the oil holes in a bearing and crankshaft."
  }
}
