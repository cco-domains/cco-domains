cco:ont00000498 a owl:Class ;
    rdfs:label "Julian Day"@en ;
    rdfs:subClassOf cco:ont00000921 ;
    skos:definition "A Calendar Day in the Julian Calendar."@en ;
    skos:scopeNote "A Julian Day begins at noon Universal Time and is twenty-four Hours in duration."@en ;
