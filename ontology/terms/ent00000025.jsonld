  "@id": "cco:ent00000025",
  "@type": "owl:Class",
  "cco:ent00000019": {
    "@language": "en",
    "@value": "Cyber Ontology (IEEE P3195.1.1) — bridge class pending CCO 2.0 migration"
  },
  "cco:ent00000020": {
    "@language": "en",
    "@value": "CyberOntology v1.5 uses old ontologyrepository.com namespace. \n        Re-declared here under CCO 2.0 namespace so UserAccount subtree is usable \n        with CCO 2.0 imports. Delete when CyberOntology CCO 2.0 is published."
  },
  "cco:ent00000022": {
    "@language": "en",
    "@value": "Bridge — awaiting CyberOntology CCO 2.0 release"
  },
  "dcterms:created": {
    "@type": "http://www.w3.org/2001/XMLSchema#date",
    "@value": "2026-03-16"
  },
  "http://purl.org/dc/elements/1.1/creator": {
    "@language": "en",
    "@value": "Global Research, Inc."
  },
  "rdfs:isDefinedBy": {
    "@id": "https://w3id.org/cco-domains/domains/StagingOntology"
  },
  "rdfs:label": {
    "@language": "en",
    "@value": "Digital File"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ont00000798"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "An Information Bearing Artifact that consists of a one-dimensional \n        array of bytes on a Digital Storage Device, and which is designed to be easily \n        opened, read, changed, and closed by an Information Processing Artifact."
  },
  "skos:exactMatch": {
    "@id": "http://www.ontologyrepository.com/CommonCoreOntologies/DigitalFile"
  }
}
