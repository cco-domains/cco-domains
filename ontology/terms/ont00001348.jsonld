    "@value": "https://w3id.org/cco-domains/cco/GeospatialOntology"
  },
  "rdfs:label": {
    "@language": "en",
    "@value": "Three-Dimensional Position"
  },
  "rdfs:subClassOf": {
    "@id": "obo:BFO_0000028"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "A Three-Dimensional Spatial Region that encompasses the (minimal) spatial region in which some object is located at a particular time."
  },
  "skos:scopeNote": {
    "@language": "en",
    "@value": "For an object in motion, its Three-Dimensional Position is part of its Three-Dimensional Path."
  }
