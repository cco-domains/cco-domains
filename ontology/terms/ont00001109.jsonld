  "skos:definition": {
    "@language": "en",
    "@value": "A Rotational Motion in which the direction of rotation is toward the left as seen relative to the designated side of the plane of rotation."
  },
  "skos:example": "the axial rotation of the Earth as seen from above the North Pole"
