  "rdfs:domain": {
    "@id": "obo:BFO_0000030"
  },
  "rdfs:label": {
    "@language": "en",
    "@value": "is material of"
  },
  "rdfs:range": {
    "@id": "obo:BFO_0000030"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "An object m is material of an object o when m is the material of which o consists and that material does not undergo a change of kind during the creation of o"
  }
