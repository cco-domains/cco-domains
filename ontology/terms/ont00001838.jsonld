  },
  "rdfs:domain": {
    "@id": "obo:BFO_0000141"
  },
  "rdfs:label": {
    "@language": "en",
    "@value": "disconnected with"
  },
  "rdfs:range": {
    "@id": "obo:BFO_0000141"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "x disconnected_with y iff x and y are both instances of Immaterial Entity and there does not exist some immaterial entity z that is part of both x and y."
  },
  "skos:scopeNote": {
    "@language": "en",
    "@value": "Given a stronger temporal interpretation, this property may be symmetric. For more info please refer to https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/temporal%20extensions."
  }
}
