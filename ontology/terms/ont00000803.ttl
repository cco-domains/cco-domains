@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cco:ont00000803 a owl:Class ;
    rdfs:label "Round"@en ;
    rdfs:subClassOf cco:ont00001059 ;
    skos:altLabel "Circular"@en ;
    skos:definition "A Shape Quality that inheres in a bearer in virtue of every point along its circumference being equidistant from the center."@en ;
    cco:ont00001754 "http://www.merriam-webster.com/dictionary/round" ;
    cco:ont00001760 "https://w3id.org/cco-domains/cco/QualityOntology"^^xsd:anyURI .

