cco:ont00001695 a owl:NamedIndividual,
        cco:ont00000630 ;
    rdfs:label "Universal Time 2"@en ;
    skos:scopeNote "UT2 is a variant of Universal Time that smooths UT1 by accounting for both polar motion and variations in Earth's rotation due to seasonal factors, such as changes in vegetation and water or snow distribution."@en ;
    cco:ont00001753 "UT2" ;
    cco:ont00001760 "https://w3id.org/cco-domains/cco/InformationEntityOntology"^^xsd:anyURI .

