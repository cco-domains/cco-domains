  "rdfs:label": {
    "@language": "en",
    "@value": "Rocket Engine"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ont00000533"
  },
  "skos:altLabel": {
    "@language": "en",
    "@value": "Thruster"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "A Jet Engine that is designed to use only stored Rocket Propellant to form a high speed propulsive jet in order to generate Thrust."
  },
  "skos:scopeNote": {
    "@language": "en",
    "@value": "Most rocket engines are also Internal Combustion Engines, however non-combusting forms also exist. For example, an untied balloon full of air that is released and allowed to zoom around the room may be both a Rocket Engine and a Physically Powered Engine."
  }
