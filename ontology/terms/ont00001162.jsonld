  "@context": {
    "cco": "https://w3id.org/cco-domains/cco/",
    "dcterms": "http://purl.org/dc/terms/",
    "obo": "http://purl.obolibrary.org/obo/",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "skos": "http://www.w3.org/2004/02/skos/core#"
  },
  "@id": "cco:ont00001162",
  "@type": "owl:Class",
  "cco:ont00001754": "Derived (loosely) from: John Searle's Speech Acts: An Essay in the Philosophy of Language",
  "cco:ont00001760": {
    "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value": "https://w3id.org/cco-domains/cco/EventOntology"
  },
  "rdfs:label": {
    "@language": "en",
    "@value": "Act of Commissive Communication"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ont00000402"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "An Act of Communication in which an Agent commits themselves to doing, or refraining from doing, some future action."
  },
  "skos:scopeNote": {
    "@language": "en",
    "@value": "Examples: agreeing, betting, guaranteeing, inviting, offering, promising, swearing, volunteering"
  }
}
