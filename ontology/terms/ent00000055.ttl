@prefix cco: <https://w3id.org/cco-domains/cco/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cco:ent00000055 a owl:Class ;
    rdfs:label "Telecommunication Network Identifier"@en ;
    dc:creator "Global Research, Inc."@en ;
    dcterms:created "2026-07-09"^^xsd:date ;
    rdfs:isDefinedBy <https://w3id.org/cco-domains/domains/StagingOntology> ;
    rdfs:subClassOf cco:ont00000686 ;
    skos:definition """A Designative Information Content Entity that uniquely identifies 
        a Telecommunication Network or some set of information inhering in such a network, 
        often for the purpose of exchanging information with the identified entity."""@en ;
    skos:exactMatch <http://www.ontologyrepository.com/CommonCoreOntologies/TelecommunicationNetworkIdentifier> ;
    skos:scopeNote """Superclass of TelephoneNumber (ent00000023) and EmailAddress (ent00000024). 
        Migrated from Orphan-Ontology-Dev to provide the correct parent class."""@en ;
    cco:ent00000019 "Cyber Ontology (IEEE P3195.1.1)"@en ;
    cco:ent00000020 "Migrated from Orphan-Ontology-Dev CCO 1.x."@en ;
    cco:ent00000022 "To be proposed to Cyber Ontology (IEEE P3195.1.1) 2026-Q3"@en .

