    "@value": "https://w3id.org/cco-domains/cco/ArtifactOntology"
  },
  "rdfs:label": {
    "@language": "en",
    "@value": "Nominal Speed Artifact Function"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ont00001353"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "A Speed Artifact Function that is realized in some process in which the Artifact bearing the Artifact Function attains a speed that does not exceed some specified tolerance of that Material Artifact."
  }
