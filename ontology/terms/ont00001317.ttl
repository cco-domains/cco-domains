@prefix cco: <https://w3id.org/cco-domains/cco/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cco:ont00001317 a owl:Class ;
    rdfs:label "Measurement Unit of Volume"@en ;
    rdfs:subClassOf cco:ont00000120 ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of sites or three-dimensional spatial regions."@en ;
    skos:example "cubic feet, cubic meter, quart, liter" ;
    cco:ont00001760 "https://w3id.org/cco-domains/cco/UnitsOfMeasureOntology"^^xsd:anyURI .

