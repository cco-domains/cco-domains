  "rdfs:label": {
    "@language": "en",
    "@value": "Semi-automatic Pistol"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ont00000156"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "A Hand Gun that has a single fixed firing chamber machined into the rear of the barrel and an ammunition magazine capable of holding multiple Cartridges such that the Hand Gun is designed to automatically reload each time it is fired and to fire a Bullet with each successive pull of the trigger until the stored ammunition is depleted."
  }
