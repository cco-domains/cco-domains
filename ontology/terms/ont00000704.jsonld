  "@id": "cco:ont00000704",
  "@type": "owl:Class",
  "cco:ont00001754": "Federal Highway Administration. Guidance on Structures Subject to the National Tunnel Inspection Standards (NTIS). United States Department of Transportation, 27 Oct. 2015",
  "cco:ont00001760": {
    "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value": "https://w3id.org/cco-domains/cco/ArtifactOntology"
  },
  "rdfs:label": {
    "@language": "en",
    "@value": "Constructed Tunnel"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ont00000254"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "A Transportation Artifact that is designed to be substantially enclosed, have access constrained to portals, and to enable travel through surrounding soil, earth, or rock formation."
  },
  "skos:scopeNote": {
    "@language": "en",
    "@value": "This class is not intended to include natural tunnels, such as caves."
  }
}
