  "@id": "cco:ont00001983",
  "@type": "owl:ObjectProperty",
  "cco:ont00001760": {
    "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value": "https://w3id.org/cco-domains/cco/InformationEntityOntology"
  },
  "rdfs:domain": {
    "@id": "cco:ont00001022"
  },
  "rdfs:label": {
    "@language": "en",
    "@value": "is a ratio measurement of"
  },
  "rdfs:range": {
    "@id": "obo:BFO_0000001"
  },
  "rdfs:subPropertyOf": {
    "@id": "cco:ont00001966"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "x is_a_ratio_measurement_of y iff x is an instance of Ratio Measurement Information Content Entity and y is an instance of Entity and x describes some attribute of y relative to a scale having equal unit values and a zero value that corresponds to the absence of the attribute being measured."
  }
}
