  "@id": "cco:ont00000614",
  "@type": "owl:Class",
  "cco:ont00001760": {
    "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value": "https://w3id.org/cco-domains/cco/QualityOntology"
  },
  "rdfs:label": {
    "@language": "en",
    "@value": "Mass"
  },
  "rdfs:subClassOf": {
    "@id": "obo:BFO_0000019"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "A Quality that inheres in a bearer in virtue of the amount of matter in that bearer."
  },
  "skos:scopeNote": [
    {
      "@language": "en",
      "@value": "'Matter' here can also refer to the inertial energy of an object."
    },
    {
      "@language": "en",
      "@value": "Typical unit of measure is the kilogram or pound."
    }
  ]
}
