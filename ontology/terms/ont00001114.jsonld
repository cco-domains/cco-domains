      "skos:definition": {
        "@language": "en",
        "@value": "A Geospatial Region that is a fiat division of a Delimiting Domain and not a Delimiting Domain."
      },
      "skos:example": "Flatbush, French Quarter, Western New York, Texas Panhandle, Greater Montreal Area of Quebec, Pacific Northwest, southwest area of Al Anbar Province, Northern Iraq.",
      "skos:scopeNote": {
        "@language": "en",
        "@value": "Instances of this class are not proper Delimiting Domains, but in some cases may have an organization that exercises some control over the region, such as the homeowners' association for a neighborhood."
      }
    }
