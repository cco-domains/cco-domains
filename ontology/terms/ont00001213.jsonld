  "@type": "owl:Class",
  "cco:ont00001760": {
    "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value": "https://w3id.org/cco-domains/cco/EventOntology"
  },
  "rdfs:label": {
    "@language": "en",
    "@value": "Stasis of Artifact Operationality"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ont00000246"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "A Stasis of Realizable Entity that holds during a Temporal Interval when a Material Artifact's designed set of Artifact Functions (or at least its primary functions) or the realizations of those functions remain unchanged."
  }
