  },
  "rdfs:label": {
    "@language": "en",
    "@value": "Universal Time 0"
  },
  "skos:scopeNote": {
    "@language": "en",
    "@value": "UT0 is a variant of Universal Time that is measured by observing the diurnal motion of stars or extragalactic radio sources at a specific location on Earth. It does not take into consideration distorting factors, in particular polar motion, such that its value will differ based on the location it is measured at."
  }
