  "@id": "cco:ont00001961",
  "@type": "owl:ObjectProperty",
  "cco:ont00001760": {
    "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value": "https://w3id.org/cco-domains/cco/InformationEntityOntology"
  },
  "rdfs:domain": {
    "@id": "cco:ont00000120"
  },
  "rdfs:label": {
    "@language": "en",
    "@value": "is measurement unit of"
  },
  "rdfs:range": {
    "@id": "cco:ont00000253"
  },
  "rdfs:subPropertyOf": {
    "@id": "obo:BFO_0000084"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "x is_measurement_unit_of y iff y is an instance of Information Bearing Entity and x is an instance of Measurement Unit, such that x describes the magnitude of measured physical quantity mentioned in y."
  }
