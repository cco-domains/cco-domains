  "rdfs:label": {
    "@language": "en",
    "@value": "is an interval measurement of"
  },
  "rdfs:range": {
    "@id": "obo:BFO_0000001"
  },
  "rdfs:subPropertyOf": {
    "@id": "cco:ont00001966"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "x is_an_interval_measurement_of y iff x is an instance of Interval Measurement Information Content Entity and y is an instance of Entity and y is_measured_by_interval x."
  },
  "skos:example": "a measurement of air temperature on the Celsius scale."
}
