@prefix cco: <https://w3id.org/cco-domains/cco/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cco:ont00000772 a owl:Class ;
    rdfs:label "Impulsive Force"@en ;
    rdfs:subClassOf obo:BFO_0000144 ;
    skos:altLabel "Imp"@en,
        "Impulse"@en,
        "J"@en ;
    skos:definition "A Process Profile that is the integral of a Force that is applied to a portion of matter over a period of time."@en ;
    skos:scopeNote "An Impulse changes the Momentum (and potentially also the direction of Motion) of the object it is applied to and is typically measured in Newton meters."@en ;
    cco:ont00001760 "https://w3id.org/cco-domains/cco/EventOntology"^^xsd:anyURI .

