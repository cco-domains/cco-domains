    "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value": "https://w3id.org/cco-domains/cco/TimeOntology"
  },
  "rdfs:label": {
    "@language": "en",
    "@value": "Modified Julian Date"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ont00000223"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "A Time of Day as specified according to the Julian Calendar using the Modified Julian Date epoch."
  },
  "skos:scopeNote": {
    "@language": "en",
    "@value": "A Day begins at midnight GMT within the Modified Julian Date reference system. The Modified Julian Date (MJD) is related to the Julian Date (JD) by the formula:\nMJD = JD - 2400000.5"
  }
