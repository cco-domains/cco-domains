  "@id": "cco:ont00000051",
  "@type": "owl:Class",
  "cco:ont00001760": {
    "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value": "https://w3id.org/cco-domains/cco/EventOntology"
  },
  "rdfs:label": {
    "@language": "en",
    "@value": "Act of Construction"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ont00000908"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "An Act of Material Artifact Processing wherein Material Artifacts are built on site as prescribed by some contract."
  },
  "skos:scopeNote": {
    "@language": "en",
    "@value": "An Act of Construction typically involves the production of only one or a limited number of goods, such as in the construction of an airport or a community of condominiums."
  }
}
