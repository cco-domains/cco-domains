    "owl": "http://www.w3.org/2002/07/owl#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "skos": "http://www.w3.org/2004/02/skos/core#"
  },
  "@id": "cco:ent00000050",
  "@type": "owl:Class",
  "cco:ent00000019": {
    "@language": "en",
    "@value": "A future Financial domain ontology (IEEE P3195.1.x)"
  },
  "cco:ent00000020": {
    "@language": "en",
    "@value": "Migrated from Orphan-Ontology-Dev CCO 1.x. Parent corrected from FinancialArtifactFunction to PaymentCard."
  },
  "cco:ent00000022": {
    "@language": "en",
    "@value": "Proposed to Financial Domain Ontology WG when formed 2026-Q4"
  },
  "dcterms:created": {
    "@type": "http://www.w3.org/2001/XMLSchema#date",
    "@value": "2026-03-17"
  },
  "http://purl.org/dc/elements/1.1/creator": {
    "@language": "en",
    "@value": "Global Research, Inc."
  },
  "rdfs:isDefinedBy": {
    "@id": "https://w3id.org/cco-domains/domains/StagingOntology"
  },
  "rdfs:label": {
    "@language": "en",
    "@value": "Credit Card"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ent00000049"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "A Payment Card that authorizes its holder to purchase goods or \n        services on short-term credit extended by the card issuer."
  },
  "skos:exactMatch": [
    {
      "@id": "http://www.ontologyrepository.com/CommonCoreOntologies/CreditCard"
    },
    {
      "@id": "https://schema.org/CreditCard"
    }
  ],
  "skos:example": {
    "@language": "en",
    "@value": "A Visa credit card allowing purchases up to a credit limit."
  },
  "skos:scopeNote": {
    "@language": "en",
    "@value": "CreditCard authorizes purchases on short-term credit extended by the issuer. Migrated from Orphan-Ontology-Dev CCO 1.x with corrected parent (PaymentCard not FinancialArtifactFunction directly). Data models: Schema.org (CreditCard), MyDex (Dataset: Credit Card), Mee Foundation Requirements (Credit Card), Orphan-Ontology-Dev — 4+ sources."
  }
}
