  "rdfs:label": {
    "@language": "en",
    "@value": "Incorporated Organization"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ont00001180"
  },
  "skos:altLabel": {
    "@language": "en",
    "@value": "Corporation"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "An Organization formed by an Act of Incorporation that consists of an association of individuals, created by law or under authority of law, having a continuous existence independent of the existences of its members and owners, and having powers and liabilities distinct from those of its members and owners."
  }
