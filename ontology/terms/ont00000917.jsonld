  "skos:definition": {
    "@language": "en",
    "@value": "A role inhering in a Person by virtue of that Person being recognized as having legal resident status in a Government Domain in which that person is not a citizen but where they have the right to reside on a permanent basis."
  },
  "skos:prefLabel": {
    "@language": "en",
    "@value": "Permanent Resident Role"
  }
