    "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value": "https://w3id.org/cco-domains/cco/AgentOntology"
  },
  "dcterms:bibliographicCitation": "Convention on Rights and Duties of States (inter-American); December 26, 1933. https://avalon.law.yale.edu/20th_century/intam03.asp. Accessed 6 Apr. 2023.",
  "dcterms:creator": {
    "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value": "https://cubrc.org"
  },
  "rdfs:label": {
    "@language": "en",
    "@value": "Domain of a Country"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ont00001152"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "A Government Domain that is associated with certain distinct political, ethnic, or cultural characteristics, and which delimits a Government that has legitimate authority over a Populace."
  },
  "skos:editorialNote": {
    "@language": "en",
    "@value": "'Country' is an unclear term. Does it refer to the people, the government, the site, or the material in the site? Furthermore, what is properly referred to as a 'Country' is highly dependent on the classification practices of the international community. For example: The United Kingdom is a sovereign country that has Wales, a non-sovereign Country, as a member. Vatican City is a sovereign country that is landlocked by a city: Rome, Italy. Puerto Rico is not a country (it's a territory) but has a government, a distinct culture, and so on. Thus, here we do not define 'Country' but instead define 'Domain of a Country'."
  },
  "skos:prefLabel": {
    "@language": "en",
    "@value": "Domain of a Country"
  }
}
