cco:ont00000653 a owl:Class ;
    rdfs:label "Algorithm"@en ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Prescriptive Information Content Entity that prescribes some Process and contains a finite sequence of unambiguous instructions in order to achieve some Objective."@en ;
