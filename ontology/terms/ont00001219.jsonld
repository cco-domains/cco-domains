      "skos:definition": {
        "@language": "en",
        "@value": "A Process Profile that is the total change in Velocity of an object's Motion."
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "Delta-v is not equivalent to and should not be confused with Acceleration, which is the rate of change of Velocity."
