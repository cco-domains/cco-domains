  "rdfs:label": {
    "@language": "en",
    "@value": "Decimal Time of Day Identifier"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ont00000827"
  },
  "skos:altLabel": {
    "@language": "en",
    "@value": "Fractional Time of Day Identifier"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "A Time of Day Identifier that designates an approximate Temporal Instant that is part of some Day and is specified using a decimal value for the portion of the Day that preceded the Temporal Instant."
  }
