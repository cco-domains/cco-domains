  "rdfs:label": {
    "@language": "en",
    "@value": "Active Stasis"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ont00001213"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "A Stasis of Artifact Operationality that holds during a Temporal Interval when a Material Artifact is realizing one or more of its designed Artifact Functions (especially one of its primary functions)."
  }
