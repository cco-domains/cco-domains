    "owl": "http://www.w3.org/2002/07/owl#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "skos": "http://www.w3.org/2004/02/skos/core#"
  },
  "@id": "cco:ont00001933",
  "@type": "owl:ObjectProperty",
  "cco:ont00001760": {
    "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value": "https://w3id.org/cco-domains/cco/ExtendedRelationOntology"
  },
  "owl:inverseOf": {
    "@id": "cco:ont00001962"
  },
  "rdfs:domain": {
    "@id": "obo:BFO_0000015"
  },
  "rdfs:label": {
    "@language": "en",
    "@value": "process starts"
  },
  "rdfs:range": {
    "@id": "obo:BFO_0000015"
  },
  "rdfs:subPropertyOf": {
    "@id": "cco:ont00001803"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "x process_starts y iff x and y are instances of processes, and x is_cause_of y, and i is an instance of a temporal instant, and r is an instance of a temporal interval, and y has starting instance i, and x occupies temporal region r, and r has inside instant i."
  },
  "skos:scopeNote": {
    "@language": "en",
    "@value": "A process x starts another process y when x causes y while x is still occurring."
  }
}
