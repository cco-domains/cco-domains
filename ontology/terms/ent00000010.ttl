@prefix cco: <https://w3id.org/cco-domains/cco/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cco:ent00000010 a owl:Class ;
    rdfs:label "US Postal Address"@en ;
    dcterms:created "2026-06-15"^^xsd:date ;
    rdfs:isDefinedBy <https://w3id.org/cco-domains/domains/AddressOntology> ;
    rdfs:subClassOf cco:ent00000009 ;
    skos:altLabel "United States Postal Address"@en ;
    skos:definition "A postal address that complies with USPS addressing requirements and includes the delivery location line, city, dual-letter state identifier, and ZIP code."@en ;
    skos:example "210 Pennsylvania Ave NW, Washington, DC 20500"@en .

