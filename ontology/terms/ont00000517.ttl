@prefix cco: <https://w3id.org/cco-domains/cco/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cco:ont00000517 a owl:Class ;
    rdfs:label "Act of Communication by Media"@en ;
    rdfs:subClassOf cco:ont00000402 ;
    skos:definition "An Act of Communication in which some Material Artifact is used to transfer an Information Bearing Entity from sender(s) to receiver(s)."@en ;
    cco:ont00001760 "https://w3id.org/cco-domains/cco/EventOntology"^^xsd:anyURI .

