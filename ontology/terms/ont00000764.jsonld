    "@value": "https://w3id.org/cco-domains/cco/ArtifactOntology"
  },
  "rdfs:label": {
    "@language": "en",
    "@value": "Optical Focusing Artifact Function"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ont00000504"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "An Optical Processing Artifact Function that is realized by a Material Artifact participating in a light focusing event in which the Material Artifact causes the light beam to converge on a target spatial point."
  }
