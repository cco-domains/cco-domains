  "rdfs:label": {
    "@language": "en",
    "@value": "Sensor Role"
  },
  "rdfs:subClassOf": {
    "@id": "obo:BFO_0000023"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "A Role that inheres in an entity in virtue of it being used in a process wherein an attribute of its bearer acts as a proxy for some aspect of its sensing environment."
