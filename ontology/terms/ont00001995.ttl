@prefix cco: <https://w3id.org/cco-domains/cco/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cco:ont00001995 a owl:ObjectProperty ;
    rdfs:label "is parent of"@en ;
    rdfs:subPropertyOf cco:ont00001865 ;
    skos:definition "x is_parent_of y is a familial relationship between an instance of Person x and a different instance of Person y."@en ;
    cco:ont00001760 "https://w3id.org/cco-domains/cco/FamilialRelationsOntology"^^xsd:anyURI .

