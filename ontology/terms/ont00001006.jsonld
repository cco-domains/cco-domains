  "@id": "cco:ont00001006",
  "@type": "owl:Class",
  "cco:ont00001760": {
    "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value": "https://w3id.org/cco-domains/cco/AgentOntology"
  },
  "rdfs:label": {
    "@language": "en",
    "@value": "Operator Role"
  },
  "rdfs:subClassOf": {
    "@id": "obo:BFO_0000023"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "A Role that inheres in an Agent by virtue of that Agent's responsibilities to operate or control some Material Artifact."
  },
  "skos:example": [
    "the role of driving a car",
    "the role of flying an airplane",
    "the role of operating a crane"
  ]
}
