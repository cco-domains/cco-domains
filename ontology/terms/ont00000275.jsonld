  "rdfs:label": {
    "@language": "en",
    "@value": "Spatial Reference System"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ont00000398"
  },
  "skos:altLabel": [
    {
      "@language": "en",
      "@value": "Coordinate System"
    },
    {
      "@language": "en",
