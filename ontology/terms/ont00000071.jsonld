  "cco:ont00001754": "http://www.dictionary.com/browse/town",
  "cco:ont00001760": {
    "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value": "https://w3id.org/cco-domains/cco/AgentOntology"
  },
  "rdfs:label": {
    "@language": "en",
    "@value": "Town"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ont00000460"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "A Local Administrative Region in which a human population permanently resides that is typically larger than the population of a Village but smaller than that of a City; is designated as a town based on a particular administrative, legal, or historical status; and which delimits a local Government that typically exercises less power than that of a City Government."
  }
}
