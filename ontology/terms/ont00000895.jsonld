  "skos:altLabel": {
    "@language": "en",
    "@value": "Married Stasis"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "A Stasis of Generically Dependent Continuant that consists of a socially, culturally, or ritually recognized union or legal contract between spouses that establishes rights and obligations between them, between them and their children, and between them and their in-laws."
  }
