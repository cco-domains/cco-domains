@prefix cco: <https://w3id.org/cco-domains/cco/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cco:ent00000036 a owl:DatatypeProperty ;
    rdfs:label "has service URI"@en ;
    dcterms:source <https://www.rfc-editor.org/rfc/rfc9553> ;
    rdfs:domain cco:ent00000033 ;
    rdfs:isDefinedBy <https://w3id.org/cco-domains/domains/StagingOntology> ;
    rdfs:range xsd:anyURI ;
    skos:definition "The URI that locates the account or profile at the service provider."@en ;
    skos:example "\"https://example2.com/@alice\", \"xmpp:alice@example.com\""@en .

