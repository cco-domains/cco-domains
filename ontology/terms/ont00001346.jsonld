  },
  "cco:ont00001760": {
    "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value": "https://w3id.org/cco-domains/cco/ArtifactOntology"
  },
  "rdfs:label": {
    "@language": "en",
    "@value": "Legal Instrument"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ont00000995"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "A Material Artifact that is designed as a formally executed written document that can be formally attributed to its author, records and formally expresses a legally enforceable act, process, or contractual duty, obligation, or right, and therefore evidences that act, process, or agreement."
  }
