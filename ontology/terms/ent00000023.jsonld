{
  "@context": {
    "cco": "https://w3id.org/cco-domains/cco/",
    "dcterms": "http://purl.org/dc/terms/",
    "obo": "http://purl.obolibrary.org/obo/",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "skos": "http://www.w3.org/2004/02/skos/core#"
  },
  "@id": "cco:ent00000023",
  "@type": "owl:Class",
  "cco:ent00000019": {
    "@language": "en",
    "@value": "Communication/Contact Ontology (proposed IEEE P3195.1.x). Alternative: CCO InformationEntityOntology as subclass of CodeIdentifier."
  },
  "cco:ent00000020": {
    "@language": "en",
    "@value": "No existing domain ontology covers telecommunications identifiers. CCO has Telecommunication Endpoint (artifact) in ArtifactOntology but lacks the identifier class. Awaiting Communication/Contact domain ontology formation."
  },
  "cco:ent00000022": {
    "@language": "en",
    "@value": "Awaiting Communication/Contact working group formation 2026-Q2"
  },
  "dcterms:created": {
    "@type": "http://www.w3.org/2001/XMLSchema#date",
    "@value": "2026-02-18"
  },
  "http://purl.org/dc/elements/1.1/creator": {
    "@language": "en",
    "@value": "Global Research, Inc."
  },
  "owl:disjointWith": {
    "@id": "cco:ent00000024"
  },
  "rdfs:isDefinedBy": {
    "@id": "https://w3id.org/cco-domains/domains/StagingOntology"
  },
  "rdfs:label": {
    "@language": "en",
    "@value": "Telephone Number"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ent00000055"
  },
  "skos:altLabel": {
    "@language": "en",
    "@value": "Phone Number"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "A Code Identifier representing numeric sequence designating telecommunications \n                       endpoint, formatted per international standards such as E.164."
  },
  "skos:exactMatch": {
    "@id": "https://schema.org/telephone"
  },
  "skos:example": {
    "@language": "en",
    "@value": "The string '+15551234567' in E.164 format designates a telephone number."
  },
  "skos:scopeNote": {
    "@language": "en",
    "@value": "TelephoneNumber designates a Telecommunication Endpoint (an artifact \n                      defined in CCO ArtifactOntology). The number itself is information; \n                      the endpoint is the physical/cyber infrastructure being designated. \n                      TelephoneNumbers are not person-specific; they can designate endpoints \n                      for persons, organizations, or locations. Format typically follows E.164 \n                      international standard (+[country code][subscriber number])."
  }
}
