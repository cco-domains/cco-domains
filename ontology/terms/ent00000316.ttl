@prefix cco: <https://w3id.org/cco-domains/cco/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cco:ent00000316 a owl:ObjectProperty ;
    rdfs:label "has address component"@en ;
    dcterms:created "2026-06-15"^^xsd:date ;
    rdfs:domain cco:ent00000310 ;
    rdfs:isDefinedBy <https://w3id.org/cco-domains/domains/AddressOntology> ;
    rdfs:range cco:ent00000312 ;
    owl:inverseOf cco:ent00000317 ;
    skos:altLabel "hasAddressComponent"@en ;
    skos:definition "An object property that connects an Address instance to an AddressComponent instance that is a part of that address."@en .

