  "rdfs:subClassOf": {
    "@id": "obo:BFO_0000016"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "A Disposition that inheres in a liquid and is realized when the cohesive forces of the molecules in the bearer at the surface are greater than the adhesive forces of the molecules in the surrounding air."
  }
