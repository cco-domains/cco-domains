      "cco:ont00001760": {
        "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
        "@value": "https://w3id.org/cco-domains/cco/TimeOntology"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Month"
      },
      "rdfs:subClassOf": [
        {
          "@id": "_:b0"
        },
        {
          "@id": "obo:BFO_0000202"
        }
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "A Temporal Interval that is based on the approximate length of time required for a Natural Satellite to complete one cycle of its rotational motion around its Primary Body."
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "Unless otherwise specified, it is assumed that a Month is specified relative to the Rotational Motion of the Moon around the Earth. Earth Months are approximately equal to four consecutive Weeks or 30 consecutive Days."
      }
    }
  ]
