@prefix cco: <https://w3id.org/cco-domains/cco/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cco:ont00000810 a owl:Class ;
    rdfs:label "Multi-Week Temporal Interval"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001924 ;
            owl:someValuesFrom cco:ont00000619 ],
        obo:BFO_0000038 ;
    skos:definition "A one-dimensional temporal region that is measured in Weeks and spans at least one Week."@en ;
    skos:scopeNote "This is a defined class."@en ;
    cco:ont00001760 "https://w3id.org/cco-domains/cco/TimeOntology"^^xsd:anyURI .

