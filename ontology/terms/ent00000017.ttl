@prefix cco: <https://w3id.org/cco-domains/cco/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cco:ent00000017 a owl:DatatypeProperty ;
    rdfs:label "has start date"@en ;
    dcterms:created "2026-07-09"^^xsd:date ;
    dcterms:source <https://www.rfc-editor.org/rfc/rfc9553> ;
    rdfs:domain obo:BFO_0000038 ;
    rdfs:isDefinedBy <https://w3id.org/cco-domains/domains/StagingOntology> ;
    rdfs:range xsd:date ;
    skos:definition "Relates a Temporal Interval to the date on which it begins."@en ;
    cco:ent00000019 "Relocated from AddressOntology 2026-07-09; generic temporal property, not address-specific"@en .

