        "@value": "https://w3id.org/cco-domains/cco/EventOntology"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Gain of Specifically Dependent Continuant"
      },
      "rdfs:subClassOf": [
        {
          "@id": "_:b3"
        },
        {
          "@id": "cco:ont00000554"
        }
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "A Gain of Dependent Continuant in which some Independent Continuant becomes the bearer of some Specifically Dependent Continuant."
      },
      "skos:example": "A Person becomes pregnant (gain of quality), A person becomes forgetful (gain of disposition), A vehicle becomes amphibious (gain of function), A Person becomes a Database Administrator (gain of role)."
    }
