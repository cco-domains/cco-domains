  "@id": "cco:ont00000259",
  "@type": "owl:Class",
  "cco:ont00001760": {
    "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value": "https://w3id.org/cco-domains/cco/TimeOntology"
  },
  "rdfs:label": {
    "@language": "en",
    "@value": "Calendar Month"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ont00000225"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "A Month that begins and ends concurrently with the Days specified by a Calendar System to be the first and last Days of the Month."
  },
  "skos:example": "January; February; March; April; May; June; July; August; September; October; November; December"
}
