  "cco:ont00001754": "http://www.dictionary.com/browse/religion",
  "cco:ont00001760": {
    "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value": "https://w3id.org/cco-domains/cco/AgentOntology"
  },
  "rdfs:label": {
    "@language": "en",
    "@value": "Religion"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ont00000958"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "An Information Content Entity that consists of a collection of claims about the meaning or origin of existence or about the existence or nature of one or more deities, an afterlife, or spiritual or sacred entities, and which is accepted as true by an Agent or Group of Agents."
  }
