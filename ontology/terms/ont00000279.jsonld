  "@id": "cco:ont00000279",
  "@type": "owl:Class",
  "cco:ont00001760": {
    "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value": "https://w3id.org/cco-domains/cco/AgentOntology"
  },
  "rdfs:label": {
    "@language": "en",
    "@value": "Enemy Role"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ont00000392"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "An Allegiance Role that inheres in an Agent by virtue of that Agent having committed offensive Acts or exhibited intent to perform such Acts towards a particular Agent or Group of Agents or has been declared as hostile by some appropriate authority."
  }
