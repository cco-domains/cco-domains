@prefix cco: <https://w3id.org/cco-domains/cco/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cco:ent00000005 a owl:Class ;
    rdfs:label "Suffix"@en ;
    dcterms:created "2026-05-01"^^xsd:date ;
    rdfs:isDefinedBy <https://w3id.org/cco-domains/domains/PersonOntology> ;
    rdfs:subClassOf cco:ont00000003 ;
    skos:altLabel "Name Suffix"@en ;
    skos:definition "A designative name added after the person's full name to add more information (professional, generational or academic)."@en ;
    skos:example "\"Sr.\". \"Ret.\". \"PhD\""@en .

