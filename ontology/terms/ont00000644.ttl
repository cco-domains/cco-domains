@prefix cco: <https://w3id.org/cco-domains/cco/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cco:ont00000644 a owl:Class ;
    rdfs:label "Oscillation Process"@en ;
    rdfs:subClassOf cco:ont00000004 ;
    skos:altLabel "Oscillation"@en ;
    skos:definition "A Change in which the dependent entity alternates between two or more stases."@en ;
    skos:scopeNote "Oscillation is often thought of in the sense of motion, e.g., a swinging clock pendulum. However, the repetitive variation in location around a central point is technically a process of vibration, sometimes referred to as mechanical oscillation. Use the term Vibration Motion for those cases."@en ;
    cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Oscillation&oldid=1002978272"^^xsd:anyURI ;
    cco:ont00001760 "https://w3id.org/cco-domains/cco/EventOntology"^^xsd:anyURI .

