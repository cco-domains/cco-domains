{
  "@context": {
    "cco": "https://w3id.org/cco-domains/cco/",
    "dcterms": "http://purl.org/dc/terms/",
    "obo": "http://purl.obolibrary.org/obo/",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "skos": "http://www.w3.org/2004/02/skos/core#"
  },
  "@id": "cco:ont00000584",
  "@type": "owl:Class",
  "cco:ont00001760": {
    "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value": "https://w3id.org/cco-domains/cco/EventOntology"
  },
  "rdfs:label": {
    "@language": "en",
    "@value": "Act of Position Change"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ont00000357"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "An Act of Motion in which the position (i.e. the orientation, alignment, or arrangement) of some Object or of one or more of an Object's parts is changed by some Agent."
  },
  "skos:example": [
    "a top spinning in place",
    "adjusting your posture",
    "raising your left arm",
    "swivelling your office chair to face the window"
  ],
  "skos:scopeNote": {
    "@language": "en",
    "@value": "An Act of Position Change does not entail a change of location."
  }
}
