@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

cco:ent00000020 a owl:AnnotationProperty ;
    rdfs:label "staging reason"@en ;
    rdfs:comment "Explains why this term is in staging rather than an approved domain ontology."@en ;
