    "@value": "https://w3id.org/cco-domains/cco/UnitsOfMeasureOntology"
  },
  "rdfs:label": {
    "@language": "en",
    "@value": "Measurement Unit of Volumetric Flow Rate"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ont00000061"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "A Measurement Unit of Flow that is used as a standard for measurement of the rate at which volumes of fluid pass per unit time."
  },
  "skos:example": "cubic metres per second, standard cubic centimeters per minute, cubic feet per second, gallons per minute"
