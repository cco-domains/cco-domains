cco:ont00000917 a owl:Class ;
    rdfs:label "Permanent Resident Role"@en ;
    dcterms:bibliographicCitation "Permanent Residency - Wikipedia. https://en.wikipedia.org/wiki/Permanent_residency. Accessed 10 Feb. 2023." ;
