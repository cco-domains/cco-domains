@prefix cco: <https://w3id.org/cco-domains/cco/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cco:ent00000004 a owl:Class ;
    rdfs:label "Family Name"@en ;
    dcterms:created "2026-04-28"^^xsd:date ;
    rdfs:isDefinedBy <https://w3id.org/cco-domains/domains/PersonOntology> ;
    rdfs:subClassOf cco:ont00000003 ;
    skos:altLabel "Last Name"@en,
        "Surname"@en ;
    skos:definition "A designative name often referred to as a \"last name\" in Western contexts or a \"surname\" in formal contexts."@en .

