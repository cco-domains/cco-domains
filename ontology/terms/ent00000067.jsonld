  "skos:definition": {
    "@language": "en",
    "@value": "A Designative Information Content Entity that cites the civil jurisdiction in which a person's birth was registered as taking place, as recorded on an identity document. The registering jurisdiction may differ from the geographic location of the birth."
  }
