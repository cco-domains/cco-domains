  "rdfs:label": {
    "@language": "en",
    "@value": "Stasis of Partially Mission Capable"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ont00001132"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "A Stasis of Mission Capability during which the participating Continuant is capable of performing some but not all of its primary functions for the specified Mission."
