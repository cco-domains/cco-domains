  "@id": "cco:ont00000322",
  "@type": "owl:Class",
  "cco:ont00001760": {
    "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value": "https://w3id.org/cco-domains/cco/EventOntology"
  },
  "rdfs:label": {
    "@language": "en",
    "@value": "Act of Funding"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ont00000836"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "An Act of Financial Instrument Use in which an Agent (the Funder) provides some Financial Instrument to another Agent (the recipient of the funds) as a resource pool that is earmarked by the Funder for a future transaction."
  }
