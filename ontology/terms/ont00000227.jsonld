  "@id": "cco:ont00000227",
  "@type": "owl:Class",
  "cco:ont00001760": {
    "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value": "https://w3id.org/cco-domains/cco/TimeOntology"
  },
  "rdfs:label": {
    "@language": "en",
    "@value": "Julian Year"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ont00000674"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "A Calendar Year in the Julian Calendar."
  },
  "skos:scopeNote": {
    "@language": "en",
    "@value": "A Julian Year begins concurrently with January 1, ends concurrently with December 31, and has an average duration of exactly 365.25 Julian Days. Julian Years are typically indicated by prefixing a capital 'J' in front of the Year number, e.g. J2000.0 or J2018."
  }
}
