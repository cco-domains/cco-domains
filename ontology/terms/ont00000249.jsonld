    "@value": "https://w3id.org/cco-domains/cco/ArtifactOntology"
  },
  "rdfs:label": {
    "@language": "en",
    "@value": "Shaft"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ont00000995"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "A Material Artifact that is designed to rotate and transmit Torque, Power, or Rotational Motion from one machine element to another."
  },
  "skos:scopeNote": {
    "@language": "en",
    "@value": "A Shaft is usually used to connect other components of a drive train that cannot be connected directly either because of the distance between them or the need to allow for relative movement between those components."
  }
}
