  },
  "rdfs:label": {
    "@language": "en",
    "@value": "Act of Buying"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ont00001334"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "An Act of Purchasing wherein a Financial Instrument is used by an Agent (the Buyer) to acquire ownership of a good from another Agent (the Seller)."
