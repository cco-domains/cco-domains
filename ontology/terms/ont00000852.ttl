@prefix cco: <https://w3id.org/cco-domains/cco/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cco:ont00000852 a owl:Class ;
    rdfs:label "Measurement Unit of Work"@en ;
    rdfs:subClassOf cco:ont00000120 ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of displacements of points to which Forces have been applied."@en ;
    skos:example "joule, erg, kilowatt hour" ;
    cco:ont00001760 "https://w3id.org/cco-domains/cco/UnitsOfMeasureOntology"^^xsd:anyURI .

