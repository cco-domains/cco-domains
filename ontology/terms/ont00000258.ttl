@prefix cco: <https://w3id.org/cco-domains/cco/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cco:ont00000258 a owl:Class ;
    rdfs:label "Material Copy of a One-Dimensional Barcode"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000101 ;
            owl:someValuesFrom cco:ont00002020 ],
        cco:ont00001064 ;
    skos:altLabel "One-Dimensional Barcode"@en ;
    skos:definition "A Material Copy of a Barcode that is designed to carry parallel lines of varying widths and spacing that concretize some Prescriptive Information Content Entity."@en ;
    cco:ont00001760 "https://w3id.org/cco-domains/cco/BarcodeOntology"^^xsd:anyURI .

