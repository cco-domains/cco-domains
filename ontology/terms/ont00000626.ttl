@prefix cco: <https://w3id.org/cco-domains/cco/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cco:ont00000626 a owl:Class ;
    rdfs:label "Predictive Information Content Entity"@en ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:altLabel "Prediction"@en,
        "Prediction Information Content Entity"@en ;
    skos:definition "A Descriptive Information Content Entity that describes an uncertain future event."@en ;
    skos:scopeNote "Since predictions are inherently about not-yet-existant things, the Modal Relation Ontology term 'describes' (i.e. mro:describes) should be used (instead of the standard cco:describes) to relate instances of Predictive Information Content Entity to the entities they are about."@en ;
    cco:ont00001760 "https://w3id.org/cco-domains/cco/InformationEntityOntology"^^xsd:anyURI .

