  "@id": "cco:ont00000604",
  "@type": "owl:Class",
  "cco:ont00001760": {
    "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value": "https://w3id.org/cco-domains/cco/InformationEntityOntology"
  },
  "rdfs:label": {
    "@language": "en",
    "@value": "Maximum Ordinal Measurement Information Content Entity"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ont00001010"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "An Ordinal Measurement Information Content Entity that is a measurement of some entity in virtue of it being the largest or having the greatest amount relative to a nominally described set of like entities."
  }
