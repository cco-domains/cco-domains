    },
    {
      "@id": "cco:ont00000205",
      "@type": "owl:Class",
      "cco:ont00001760": {
        "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
        "@value": "https://w3id.org/cco-domains/cco/GeospatialOntology"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Object Track"
      },
      "rdfs:subClassOf": [
        {
          "@id": "_:b0"
        },
        {
          "@id": "obo:BFO_0000026"
        }
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "A One-Dimensional Spatial Region that consists of the idealized line along which an Object has traversed during some motion."
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "The exact line of the Object Track may be drawn based on the Center of Mass of the Object or another reference point, such as the location of a transponder beacon or the center of a radar cross-section, depending on the Object being tracked."
      }
    }
  ]
