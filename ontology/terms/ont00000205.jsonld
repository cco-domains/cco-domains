  "@graph": [
    {
      "@id": "_:b0",
      "@type": "owl:Restriction",
      "owl:onProperty": {
        "@id": "cco:ont00001855"
      },
      "owl:someValuesFrom": {
        "@id": "cco:ont00000170"
