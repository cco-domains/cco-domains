  "cco:ont00001760": {
    "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value": "https://w3id.org/cco-domains/cco/AgentOntology"
  },
  "owl:inverseOf": {
    "@id": "cco:ont00001925"
  },
  "rdfs:domain": {
    "@id": "cco:ont00001017"
  },
  "rdfs:label": {
    "@language": "en",
    "@value": "uses"
  },
  "rdfs:range": {
    "@id": "obo:BFO_0000040"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "x uses y iff x is an instance of an Agent and y is an instance of a Material Entity, such that both x and y participate in some instance of a Process wherein x attempts to accomplish a goal by manipulating, deploying, or leveraging some attribute of y."
  }
}
