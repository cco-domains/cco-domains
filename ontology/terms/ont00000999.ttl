@prefix cco: <https://w3id.org/cco-domains/cco/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cco:ont00000999 a owl:Class ;
    rdfs:label "Defunct Stasis"@en ;
    rdfs:subClassOf cco:ont00001213 ;
    owl:disjointWith cco:ont00001191 ;
    skos:definition "A Stasis of Artifact Operationality that holds during a Temporal Interval when a Material Artifact no longer maintains its designed set of Artifact Functions (or at least no longer maintains its primary functions)."@en ;
    cco:ont00001760 "https://w3id.org/cco-domains/cco/EventOntology"^^xsd:anyURI .

