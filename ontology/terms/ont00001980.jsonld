  "cco:ont00001760": {
    "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value": "https://w3id.org/cco-domains/cco/InformationEntityOntology"
  },
  "owl:propertyChainAxiom": {
    "@list": [
      {
        "@id": "obo:BFO_0000178"
      },
      {
        "@id": "cco:ont00001982"
      }
    ]
  },
  "rdfs:domain": {
    "@id": "cco:ont00000127"
  },
  "rdfs:label": {
    "@language": "en",
    "@value": "describes condition"
  },
  "rdfs:range": {
    "@id": "obo:BFO_0000001"
  },
  "rdfs:subPropertyOf": {
    "@id": "cco:ont00001808"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "p describes_condition c iff p is an instance of a Performance Specification and c is an instance of Entity and p has part d, and d is an instance of a Descriptive Information Content Entity, and p prescribes an entity s, and d describes c, and c is an entity that is causally relevant to s existing as prescribed by p."
  }
}
