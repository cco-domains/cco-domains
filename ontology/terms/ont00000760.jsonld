  "rdfs:label": {
    "@language": "en",
    "@value": "Surface Wave Profile"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ont00000752"
  },
  "skos:altLabel": {
    "@language": "en",
    "@value": "Surface Wave"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "A Wave Process Profile in which the Wave Process propogates along the surface of a medium and which involves both transverse and longitudinal wave profiles such that the motion of the displacement of participating particles is circular or elliptical."
  },
  "skos:example": "the motion of an ocean wave"
}
