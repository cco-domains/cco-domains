  "cco:ont00001753": "UHF",
  "cco:ont00001754": "International Telecommunication Union (ITU)",
  "cco:ont00001760": {
    "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value": "https://w3id.org/cco-domains/cco/EventOntology"
  },
  "rdfs:label": {
    "@language": "en",
    "@value": "Ultra High Frequency"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ont00000732"
  },
  "skos:altLabel": {
    "@language": "en",
    "@value": "ITU Band Number 9"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "A Microwave Frequency that is between 300 MHz and 3 GHz."
  },
  "skos:scopeNote": {
    "@language": "en",
    "@value": "The corresponding Wavelength range is 1–0.1 m.\n\nNote that the ITU definition of UHF is broader than the definition given by IEEE 521-2002 - IEEE Standard Letter Designations for Radar-Frequency Bands, which sets the frequency range at 300 MHz to 1 GHz."
  }
