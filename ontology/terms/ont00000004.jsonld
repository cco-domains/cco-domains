  "@id": "cco:ont00000004",
  "@type": "owl:Class",
  "cco:ont00001760": {
    "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value": "https://w3id.org/cco-domains/cco/EventOntology"
  },
  "rdfs:label": {
    "@language": "en",
    "@value": "Change"
  },
  "rdfs:subClassOf": {
    "@id": "obo:BFO_0000015"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "A Process in which some independent continuant endures and 1) one or more of the dependent entities it bears increase or decrease in intensity, 2) the entity begins to bear some dependent entity or 3) the entity ceases to bear some dependent entity."
  }
}
