  "@id": "cco:ont00001266",
  "@type": "owl:Class",
  "cco:ont00001754": "http://wordnetweb.princeton.edu/perl/webwn?s=vocational%20training",
  "cco:ont00001760": {
    "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value": "https://w3id.org/cco-domains/cco/EventOntology"
  },
  "rdfs:label": {
    "@language": "en",
    "@value": "Act of Vocational Training Instruction"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ont00001075"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "An Act of Training Instruction performed by an Agent who realizes a capacity derived from the Agent's affiliation with a Vocational School, Technical School, Trade Organization, or Industry Educational Program Provider by imparting skills required for a specific occupation in industry, agriculture or trade to an Agent either directly or indirectly through some communication medium."
  }
}
