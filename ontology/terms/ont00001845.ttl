@prefix cco: <https://w3id.org/cco-domains/cco/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cco:ont00001845 a owl:ObjectProperty ;
    rdfs:label "is site of"@en ;
    rdfs:domain obo:BFO_0000029 ;
    rdfs:range obo:BFO_0000015 ;
    rdfs:subPropertyOf obo:BFO_0000183 ;
    owl:inverseOf cco:ont00001918 ;
    skos:definition "x is site of y =Def y occurs at x"@en ;
    cco:ont00001760 "https://w3id.org/cco-domains/cco/ExtendedRelationOntology"^^xsd:anyURI .

