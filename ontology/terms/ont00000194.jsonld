  "@id": "cco:ont00000194",
  "@type": "owl:Class",
  "cco:ont00001760": {
    "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value": "https://w3id.org/cco-domains/cco/ArtifactOntology"
  },
  "rdfs:label": {
    "@language": "en",
    "@value": "Electrical Contact Artifact Function"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ont00000795"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "An Electrical Conduction Artifact Function that is realized by processes in which some Material Artifact is used as an endpoint of an electrical circuit from which an electrical current is passed via physical contact with the endpoint."
  }
