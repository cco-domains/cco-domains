  "rdfs:label": {
    "@language": "en",
    "@value": "CVV"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ont00000077"
  },
  "skos:altLabel": [
    {
      "@language": "en",
      "@value": "CVC"
    },
    {
      "@language": "en",
      "@value": "Card Security Code"
    },
    {
      "@language": "en",
      "@value": "Card Verification Value"
    }
  ],
  "skos:definition": {
    "@language": "en",
    "@value": "A Code Identifier printed on a payment card that helps \n        reduce online fraud by verifying that the card is physically present."
  },
  "skos:example": {
    "@language": "en",
    "@value": "The 3-digit code on the back of a Visa card is a CVV."
  },
  "skos:scopeNote": {
    "@language": "en",
    "@value": "CVV (Card Verification Value) reduces online fraud. Also known as CVC, CVV2, CID. Data models: Mee Foundation Requirements (Credit Card CVV), Orphan-Ontology-Dev — 2+ sources."
  }
}
