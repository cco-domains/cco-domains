  "rdfs:label": {
    "@language": "en",
    "@value": "Act of Possession"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ont00000228"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "A Planned Act in which an agent intentionally exercises control towards a thing."
  },
  "skos:scopeNote": {
    "@language": "en",
    "@value": "In all cases, to possess something, an agent must have an intention to possess it."
