@prefix cco: <https://w3id.org/cco-domains/cco/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cco:ont00001213 a owl:Class ;
    rdfs:label "Stasis of Artifact Operationality"@en ;
    rdfs:subClassOf cco:ont00000246 ;
    skos:definition "A Stasis of Realizable Entity that holds during a Temporal Interval when a Material Artifact's designed set of Artifact Functions (or at least its primary functions) or the realizations of those functions remain unchanged."@en ;
    cco:ont00001760 "https://w3id.org/cco-domains/cco/EventOntology"^^xsd:anyURI .

