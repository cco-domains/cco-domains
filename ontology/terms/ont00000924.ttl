@prefix cco: <https://w3id.org/cco-domains/cco/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cco:ont00000924 a owl:Class ;
    rdfs:label "Beginning of Life Stasis"@en ;
    rdfs:subClassOf cco:ont00001191 ;
    skos:definition "A Operational Stasis that holds during a Temporal Interval when a Material Artifact is first put into operational use such that its designed set of Artifact Functions is capable of operating at or near their designed peak performance levels."@en ;
    skos:scopeNote "A Beginning of Life Stasis (BoL) is a relatively brief Operational Stasis that is primarily of interest for the purpose of establishing a baseline for operational parameters to be compared to the designed specifications as well as the Material Artifact's performance throughout its operational life."@en ;
    cco:ont00001753 "BOL",
        "BoL" ;
    cco:ont00001760 "https://w3id.org/cco-domains/cco/EventOntology"^^xsd:anyURI .

