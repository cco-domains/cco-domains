  },
  "rdfs:label": {
    "@language": "en",
    "@value": "Military Time Zone Identifier"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ont00000829"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "A Time Zone Identifier that designates a spatial region where the local time is calculated according to the specified offset from Zulu time, which has no offset from Coordinated Universal Time."
  }
