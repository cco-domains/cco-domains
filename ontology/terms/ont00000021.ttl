@prefix cco: <https://w3id.org/cco-domains/cco/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cco:ont00000021 a owl:Class ;
    rdfs:label "Sensor Platform"@en ;
    rdfs:subClassOf obo:BFO_0000040 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( obo:BFO_0000040 [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000196 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:unionOf ( cco:ont00000023 cco:ont00002074 ) ] ] ) ] ;
    skos:definition "A Material Entity that bears a Sensor Platform Artifact Function or Sensor Platform Role."@en ;
    cco:ont00001760 "https://w3id.org/cco-domains/cco/ArtifactOntology"^^xsd:anyURI .

