@prefix cco: <https://w3id.org/cco-domains/cco/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cco:ent00000070 a owl:ObjectProperty ;
    rdfs:label "has expiration date"@en ;
    dcterms:created "2026-07-13"^^xsd:date ;
    rdfs:isDefinedBy <https://w3id.org/cco-domains/domains/StagingOntology> ;
    rdfs:range cco:ont00001340 ;
    rdfs:subPropertyOf cco:ont00001879 ;
    skos:definition "Relates a thing (document, credential, etc.)  with a validity period to the Calendar Date Identifier designating the date after which it is no longer valid."@en .

