  "skos:definition": {
    "@language": "en",
    "@value": "A Disrupting Disposition the realization of which would disrupt a process that the bearer of the Disrupting Disposition has an interest in."
  },
  "skos:editorialNote": "This is defined class. A Vulnerability is indexed by the interest_in object property. A disposition can be a Vulnerability according to one index and not a Vulnerability according to another index.",
  "skos:prefLabel": {
    "@language": "en",
    "@value": "Vulnerability"
  }
