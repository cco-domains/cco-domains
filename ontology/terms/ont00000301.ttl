@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cco:ont00000301 a owl:Class ;
    rdfs:label "Vehicle Transmission"@en ;
    rdfs:subClassOf cco:ont00000663 ;
    skos:altLabel "Gearbox"@en,
        "Transmission"@en ;
