  "@id": "cco:ont00000925",
  "@type": "owl:Class",
  "cco:ont00001760": {
    "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value": "https://w3id.org/cco-domains/cco/EventOntology"
  },
  "rdfs:label": {
    "@language": "en",
    "@value": "Act of Military Training Acquisition"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ont00000687"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "An Act of Training Acquisition performed by an Agent by acquiring knowledge of the tactics, techniques, and/or strategies of Military Operations from an Agent or communication medium that realizes a capacity derived from its affiliation with a Military Organization."
  }
