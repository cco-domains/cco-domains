  "rdfs:label": {
    "@language": "en",
    "@value": "Credit Card Number"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ont00000077"
  },
  "skos:altLabel": [
    {
      "@language": "en",
      "@value": "PAN"
    },
    {
      "@language": "en",
      "@value": "Primary Account Number"
    }
  ],
  "skos:definition": {
    "@language": "en",
    "@value": "A Code Identifier that designates a payment card account, \n        formatted as a sequence of digits following ISO/IEC 7812."
  },
  "skos:example": {
    "@language": "en",
    "@value": "The 16-digit number embossed on a Visa card designates the card account."
  },
  "skos:scopeNote": {
    "@language": "en",
    "@value": "CreditCardNumber (also PAN / Primary Account Number) is the sequence of digits per ISO/IEC 7812 that designates the card account. Data models: Mee Foundation Requirements (Credit Card Number), Orphan-Ontology-Dev — 2+ sources."
  }
}
