  },
  "rdfs:domain": {
    "@id": "obo:BFO_0000015"
  },
  "rdfs:label": {
    "@language": "en",
    "@value": "inhibited by"
  },
  "rdfs:range": {
    "@id": "obo:BFO_0000015"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "y inhibited_by x iff x and y are non-identical Processes, d is a Decrease of Realizable Entity, and x is_cause_of d, and r is a Realizable Entity, and d has_participant r, and r realized_in y."
  }
}
