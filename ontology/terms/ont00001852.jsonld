  "cco:ont00001760": {
    "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value": "https://w3id.org/cco-domains/cco/AgentOntology"
  },
  "owl:inverseOf": {
    "@id": "cco:ont00001949"
  },
  "rdfs:domain": {
    "@id": "cco:ont00001017"
  },
  "rdfs:label": {
    "@language": "en",
    "@value": "accessory in"
  },
  "rdfs:range": {
    "@id": "obo:BFO_0000015"
  },
  "rdfs:subPropertyOf": {
    "@id": "obo:BFO_0000056"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "x is_accessory_in y iff x is an instance of Agent and y is an instance of Process such that x assists another instance of Agent z in the commission of y, and x was not located at the location of y when y occurred, and x is not an agent_in y."
  }
}
