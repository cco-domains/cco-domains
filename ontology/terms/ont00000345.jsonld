  "@id": "cco:ont00000345",
  "@type": "owl:Class",
  "cco:ont00001760": {
    "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value": "https://w3id.org/cco-domains/cco/EventOntology"
  },
  "rdfs:label": {
    "@language": "en",
    "@value": "Act of Measuring"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ont00000228"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "A Planned Act that involves determining the extent, dimensions, quanity, or quality of an Entity relative to some standard."
  },
  "skos:example": [
    "putting an object on a scale to measure its weight in kilograms",
    "rating Hollywood movies on a 1 to 5 star scale",
    "using a tape measure to determine the height and width of a doorway in inches"
  ]
}
