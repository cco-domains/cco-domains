@prefix cco: <https://w3id.org/cco-domains/cco/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cco:ont00000359 a owl:Class ;
    rdfs:label "Julian Date"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000132 ;
            owl:someValuesFrom cco:ont00000498 ],
        cco:ont00000223 ;
    skos:definition "A Time of Day as specified according to the Julian Calendar using the Julian Date epoch."@en ;
    cco:ont00001753 "JD" ;
    cco:ont00001754 "https://www.defit.org/julian-date/" ;
    cco:ont00001760 "https://w3id.org/cco-domains/cco/TimeOntology"^^xsd:anyURI .

