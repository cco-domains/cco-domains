@prefix cco: <https://w3id.org/cco-domains/cco/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cco:ont00001307 a owl:Class ;
    rdfs:label "Measurement Unit of Mass Flow Rate"@en ;
    rdfs:subClassOf cco:ont00000061 ;
    skos:definition "A Measurement Unit of Flow that is used as a standard for measurement of the rate at which the Mass of a substance passes per unit time."@en ;
    skos:example "kilogram per second, slug per second, pound per second" ;
    cco:ont00001760 "https://w3id.org/cco-domains/cco/UnitsOfMeasureOntology"^^xsd:anyURI .

