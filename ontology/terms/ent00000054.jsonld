{
  "@context": {
    "cco": "https://w3id.org/cco-domains/cco/",
    "dcterms": "http://purl.org/dc/terms/",
    "obo": "http://purl.obolibrary.org/obo/",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "skos": "http://www.w3.org/2004/02/skos/core#"
  },
  "@id": "cco:ent00000054",
  "@type": "owl:Class",
  "cco:ent00000019": {
    "@language": "en",
    "@value": "A future Financial domain ontology (IEEE P3195.1.x)"
  },
  "cco:ent00000020": {
    "@language": "en",
    "@value": "Migrated from Orphan-Ontology-Dev CCO 1.x. Parent corrected from TimeOfDayIdentifier to CalendarDateIdentifier."
  },
  "cco:ent00000022": {
    "@language": "en",
    "@value": "Proposed to Financial Domain Ontology WG when formed 2026-Q4"
  },
  "dcterms:created": {
    "@type": "http://www.w3.org/2001/XMLSchema#date",
    "@value": "2026-03-17"
  },
  "http://purl.org/dc/elements/1.1/creator": {
    "@language": "en",
    "@value": "Global Research, Inc."
  },
  "rdfs:isDefinedBy": {
    "@id": "https://w3id.org/cco-domains/domains/StagingOntology"
  },
  "rdfs:label": {
    "@language": "en",
    "@value": "Expiration Date Identifier"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ont00001340"
  },
  "skos:altLabel": {
    "@language": "en",
    "@value": "Card Expiry Date"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "A Calendar Date Identifier that designates the date after which \n        a payment card is no longer valid for transactions."
  },
  "skos:example": {
    "@language": "en",
    "@value": "The date '12/28' on a credit card indicates the card expires at the end of December 2028."
  },
  "skos:scopeNote": {
    "@language": "en",
    "@value": "Parent corrected from TimeOfDayIdentifier (Orphan-Ontology-Dev CCO 1.x) \n        to CalendarDateIdentifier (CCO 2.0 ont00001340). An expiration date designates \n        a calendar date, not a time of day. Also known as 'valid thru' date. \n        Data models: Mee Foundation Requirements (Credit Card expiration date), \n        Orphan-Ontology-Dev — 2+ sources."
  }
}
