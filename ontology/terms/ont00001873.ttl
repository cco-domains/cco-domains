@prefix cco: <https://w3id.org/cco-domains/cco/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cco:ont00001873 a owl:ObjectProperty ;
    rdfs:label "represented by"@en ;
    rdfs:domain obo:BFO_0000001 ;
    rdfs:range cco:ont00001069 ;
    rdfs:subPropertyOf cco:ont00001801 ;
    owl:inverseOf cco:ont00001938 ;
    skos:definition "x represented by y =Def y represents x"@en ;
    skos:scopeNote "See notes for inverse property." ;
    cco:ont00001760 "https://w3id.org/cco-domains/cco/InformationEntityOntology"^^xsd:anyURI .

