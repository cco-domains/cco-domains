    "owl": "http://www.w3.org/2002/07/owl#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "skos": "http://www.w3.org/2004/02/skos/core#"
  },
  "@id": "cco:ont00000133",
  "@type": "owl:Class",
  "cco:ont00001754": "Derived (loosely) from: John Searle's Speech Acts: An Essay in the Philosophy of Language",
  "cco:ont00001760": {
    "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value": "https://w3id.org/cco-domains/cco/EventOntology"
  },
  "rdfs:label": {
    "@language": "en",
    "@value": "Act of Directive Communication"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ont00000402"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "An Act of Communication that is intended to cause the hearer to take a particular action."
  },
  "skos:scopeNote": {
    "@language": "en",
    "@value": "Examples: advising, admonishing, asking, begging, dismissing, excusing, forbidding, instructing, ordering, permitting, requesting, requiring, suggesting, urging, warning"
  }
}
