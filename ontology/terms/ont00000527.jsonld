  "rdfs:label": {
    "@language": "en",
    "@value": "Measurement Unit of Rotational Inertia"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ont00000120"
  },
  "skos:altLabel": [
    {
      "@language": "en",
      "@value": "Measurement Unit of Moment of Inertia"
    },
    {
      "@language": "en",
      "@value": "Measurement Unit of Rotational Mass"
