  "skos:definition": {
    "@language": "en",
    "@value": "A Measurement Unit that is used as a standard for measurement of the distribution of Mass of an object with respect to its axis of rotation."
  },
  "skos:scopeNote": {
    "@language": "en",
    "@value": "A measure of an object’s resistance to change in its state of rotation."
  }
