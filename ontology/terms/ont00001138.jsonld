  },
  "skos:definition": {
    "@language": "en",
    "@value": "A Wire Antenna that consists of a horizontal wire one-half to two wavelengths long that is suspended above the ground with one end attached to the receiver feedline and the other grounded and which is typically used in the low and medium frequency radio bands."
  }
