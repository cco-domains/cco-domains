@prefix cco: <https://w3id.org/cco-domains/cco/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cco:ont00001886 a owl:ObjectProperty ;
    rdfs:label "is affected by"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( obo:BFO_0000020 obo:BFO_0000031 [ a owl:Class ;
                        owl:intersectionOf ( obo:BFO_0000004 [ a owl:Class ;
                                    owl:complementOf obo:BFO_0000006 ] ) ] ) ] ;
    rdfs:range obo:BFO_0000015 ;
    rdfs:subPropertyOf obo:BFO_0000056 ;
    skos:definition "x is affected by y =Def x participates in y, x is an Independent Continuant (but not a Spatial Region), y is a Process, and y influences x in some manner, most often by producing a change in x."@en ;
    cco:ont00001760 "https://w3id.org/cco-domains/cco/ExtendedRelationOntology"^^xsd:anyURI .

