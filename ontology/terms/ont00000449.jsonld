  "cco:ont00001754": {
    "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value": "https://en.wikipedia.org/w/index.php?title=Remuneration&oldid=1033306001"
  },
  "cco:ont00001760": {
    "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value": "https://w3id.org/cco-domains/cco/EventOntology"
  },
  "rdfs:label": {
    "@language": "en",
    "@value": "Act of Remuneration"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ont00001334"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "An Act of Purchasing wherein a Financial Instrument is used by an Agent (the Employer) to compensate another Agent (the Employee) for the services they perform for the Employer."
  },
  "skos:scopeNote": {
    "@language": "en",
    "@value": "Comment: Remuneration normally consists of salary or hourly wages, but also applies to commission, stock options, fringe benefits, etc."
  }
}
