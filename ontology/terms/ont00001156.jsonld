        "@value": "https://w3id.org/cco-domains/cco/ArtifactOntology"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Material Copy of a Information Line"
      },
      "rdfs:subClassOf": [
        {
          "@id": "_:b0"
        },
        {
          "@id": "cco:ont00000798"
        }
      ],
      "skos:altLabel": {
        "@language": "en",
        "@value": "Information Line"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "An Information Bearing Artifact that consists of a single line or row of some larger Information Bearing Artifact of which it is a part."
      },
      "skos:example": [
        "a line in a computer file that bears a portion of code for some computer program",
        "a line of data in a database",
        "a line of text in a book"
      ]
    }
