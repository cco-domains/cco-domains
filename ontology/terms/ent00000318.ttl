@prefix cco: <https://w3id.org/cco-domains/cco/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cco:ent00000318 a owl:DatatypeProperty ;
    rdfs:label "has street address value"@en ;
    dcterms:created "2026-06-15"^^xsd:date ;
    rdfs:domain cco:ent00000011 ;
    rdfs:isDefinedBy <https://w3id.org/cco-domains/domains/AddressOntology> ;
    rdfs:range xsd:string ;
    skos:altLabel "hasStreetAddressValue"@en ;
    skos:definition "A datatype property that associates a Street Address instance with its string value."@en .

