@prefix cco: <https://w3id.org/cco-domains/cco/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cco:ont00001058 a owl:Class ;
    rdfs:label "Hour"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001869 ;
            owl:someValuesFrom cco:ont00000800 ],
        obo:BFO_0000202 ;
    skos:definition "A Temporal Interval that is equal to sixty consecutive Minutes."@en ;
    cco:ont00001754 "http://wordnetweb.princeton.edu/perl/webwn?s=hour" ;
    cco:ont00001760 "https://w3id.org/cco-domains/cco/TimeOntology"^^xsd:anyURI .

