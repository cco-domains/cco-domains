  "rdfs:label": {
    "@language": "en",
    "@value": "Triple Inertial Navigation System"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ont00000287"
  },
  "skos:altLabel": {
    "@language": "en",
    "@value": "Triple INS"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "An Inertial Navigation System that is designed to use three redundant computers to continuously calculate via dead reckoning the position, orientation, and velocity of a moving object without the need for external references, in such a way that eliminates the need for a navigator."
  }
