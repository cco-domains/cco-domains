  "rdfs:subClassOf": {
    "@id": "cco:ont00000392"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "An Allegiance Role that inheres in an Agent in virtue of that Agent's commitment to perform Acts that support the Objectives of a particular Agent or Group of Agents."
