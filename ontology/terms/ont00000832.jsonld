      "skos:definition": {
        "@language": "en",
        "@value": "A Temporal Interval that is equal to the approximate length of time required for an Astronomical Body to complete one Orbital Revolution around its Primary Body as specified relative to a particular Temporal Reference System."
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "Unless otherwise specified, a Year is assumed to be relative to the Orbiting of the Earth around the Sun and is approximately equal to 12 Months or 365 Days."
      }
    }
