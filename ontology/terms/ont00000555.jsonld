  },
  "rdfs:label": {
    "@language": "en",
    "@value": "Enhanced Stasis"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ont00000135"
  },
  "skos:altLabel": {
    "@language": "en",
    "@value": "Enhanced"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "A Stasis of Specifically Dependent Continuant in which some Independent Continuant bears a Quality or Realizable Entity that has undergone improvement (i.e., an increase or gain) due to a previous action or event such that the Independent Continuant is now of greater value, usefulness, or functionality."
  }
