{
  "@context": {
    "cco": "https://w3id.org/cco-domains/cco/",
    "dcterms": "http://purl.org/dc/terms/",
    "obo": "http://purl.obolibrary.org/obo/",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "skos": "http://www.w3.org/2004/02/skos/core#"
  },
  "@id": "cco:ent00000073",
  "@type": "owl:ObjectProperty",
  "cco:ent00000019": {
    "@language": "en",
    "@value": "A future Financial domain ontology."
  },
  "cco:ent00000020": {
    "@language": "en",
    "@value": "Promoted from Mee persona:hasPaymentCard. No existing CCO object property relates an Agent to a Payment Card."
  },
  "rdfs:domain": {
    "@id": "cco:ont00001017"
  },
  "rdfs:isDefinedBy": {
    "@id": "https://w3id.org/cco-domains/domains/StagingOntology"
  },
  "rdfs:label": {
    "@language": "en",
    "@value": "has payment card"
  },
  "rdfs:range": {
    "@id": "cco:ent00000049"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "An object property that relates an Agent to a Payment Card that the Agent has and is authorized to use."
  },
  "skos:example": {
    "@language": "en",
    "@value": "Bob has VISA debit card issued by XYZ bank."
  },
  "skos:scopeNote": {
    "@language": "en",
    "@value": "Use this property to relate an Agent (cco:ont00001017), often a Person (cco:ont00001262), to any subclass of Payment Card (cco:ent00000049), including Credit Card and Debit Card. An Agent may hold multiple Payment Cards simultaneously. This property is broad — application-level SHACL constraints may restrict the domain to Person or limit cardinality as needed."
  }
}
