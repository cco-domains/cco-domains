  "skos:definition": {
    "@language": "en",
    "@value": "A Designative Information Content Entity that cites the governmental jurisdiction that issued an identity document, as recorded on that document. Designates a governing authority (e.g., national, state, provincial, agency, county, municipal, utility, etc.), not a postal address component."
  }
