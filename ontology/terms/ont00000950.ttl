cco:ont00000950 a owl:Class ;
    rdfs:label "Act of Maintenance"@en ;
    rdfs:subClassOf cco:ont00000970 ;
    skos:definition "An Act of Artifact Modification in which a Material Artifact is modified in order to preserve or restore one or more of its designed Qualities or Functions."@en ;
