  },
  "rdfs:label": {
    "@language": "en",
    "@value": "Sawtooth Waveform"
  },
  "rdfs:subClassOf": {
    "@id": "cco:ont00001286"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "A Waveform that is characterized by a sawtooth shape due to the continuous linear transition from minimum to maximum Amplitudes followed by a near-instantaneous transition from the maximum to minimum Amplitudes of the Wave Cycle."
  }
