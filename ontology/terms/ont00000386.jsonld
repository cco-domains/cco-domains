  "skos:altLabel": {
    "@language": "en",
    "@value": "Act of Webcasting"
  },
  "skos:definition": {
    "@language": "en",
    "@value": "An Act of Communciation by Media transmitted to an audience over the Internet using streaming media technology to distribute a single content source that may be distributed live or on demand."
  },
  "skos:scopeNote": {
    "@language": "en",
    "@value": "Essentially, webcasting is “broadcasting” over the Internet."
  }
