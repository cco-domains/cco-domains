@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix cco:     <https://w3id.org/cco-domains/cco/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix topic:   <http://mee.foundation/ontologies/topic#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix cp:      <https://w3id.org/cco-domains/conformance/> .

cp:BaseConformanceProfile
    a owl:Ontology ;
    rdfs:label "CCO-Domains Base Conformance Profile"@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:creator "Global Research, Inc., a 501(c)(3) nonprofit organization" ;
    dcterms:created "2026-08-19"^^xsd:date ;
    owl:versionIRI <https://w3id.org/cco-domains/conformance/2026-08-19> ;
    owl:versionInfo "v0.1 — base conformance profile."@en .

cp:keyingTier
    a owl:AnnotationProperty ;
    rdfs:label "keying tier"@en ;
    rdfs:comment "Identity-keying tier (strong/weak/non)."@en .

cp:DesignationNodeShape
    a sh:NodeShape ;
    rdfs:label "Designation node"@en ;
    sh:property [
        sh:path cco:ont00001765 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:message "A designation node shall have exactly one has-text-value literal."@en ;
    ] .

cp:DesignatedSubjectShape
    a sh:NodeShape ;
    rdfs:label "Designated subject"@en ;
    sh:targetSubjectsOf cco:ont00001879 ;
    sh:property [
        sh:path cco:ont00001879 ;
        sh:node cp:DesignationNodeShape ;
        sh:message "Every value of designated-by shall be a well-formed designation node."@en ;
    ] .

cp:CarriedIdentifierShape
    a sh:NodeShape ;
    rdfs:label "Carried identifier"@en ;
    sh:targetObjectsOf obo:BFO_0000101 ;
    sh:node cp:DesignationNodeShape ;
    sh:message "An identifier carried by a document shall be a well-formed designation node."@en .

cp:MatchableIdentifierShape
    a sh:NodeShape ;
    rdfs:label "Matchable identifier"@en ;
    sh:node cp:DesignationNodeShape .


cp:CalendarDateNodeShape
    a sh:NodeShape ;
    rdfs:label "Calendar date node"@en ;
    sh:targetClass cco:ont00001340 ;
    sh:property [
        sh:path cco:ont00001765 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:message "A calendar date value shall be a typed xsd:date literal."@en ;
    ] .


cp:MeasurementNodeShape
    a sh:NodeShape ;
    rdfs:label "Measurement node"@en ;
    sh:targetClass cco:ont00001163 ;
    sh:property [
        sh:path cco:ont00001765 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:message "A measurement shall carry exactly one literal value."@en ;
    ] ;
    sh:property [
        sh:path cco:ont00001863 ;
        sh:minCount 1 ;
        sh:message "A measurement shall reference a measurement unit."@en ;
    ] .

cp:SCtopicShape
    a sh:NodeShape ;
    rdfs:label "Subject-claimant topic"@en ;
    sh:targetClass topic:SCTopicGraph ;
    sh:property [
        sh:path topic:claimant ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "An SCTopicGraph shall have exactly one claimant."@en ;
    ] ;
    sh:property [
        sh:path topic:subject ;
        sh:minCount 1 ;
        sh:message "An SCTopicGraph shall have at least one subject."@en ;
    ] .

cp:KeyingTierShape
    a sh:NodeShape ;
    rdfs:label "Keying-tier declaration"@en ;
    sh:targetSubjectsOf cp:keyingTier ;
    sh:property [
        sh:path cp:keyingTier ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "strong" "weak" "non" ) ;
        sh:message "keyingTier shall be exactly one of: strong, weak, non."@en ;
    ] .