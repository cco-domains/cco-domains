@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix cco:     <https://w3id.org/cco-domains/cco/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix cp:      <https://w3id.org/cco-domains/conformance/> .
@prefix cco-s: <https://w3id.org/cco-domains/domains/StagingOntology#> .

cp:BaseConformanceProfile
    a owl:Ontology ;
    rdfs:label "CCO-Domains Base Conformance Profile"@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:creator "Global Research, Inc., a 501(c)(3) nonprofit organization" ;
    dcterms:created "2026-10-09"^^xsd:date ;
    owl:versionIRI <https://w3id.org/cco-domains/conformance/2026-10-09> ;
    owl:versionInfo "v0.2 — base conformance profile."@en .

cp:identifierStrength
    a owl:AnnotationProperty ;
    rdfs:label "identifier strength"@en ;
    rdfs:comment "Identifier strength: strong = auto-merge permitted; weak = merge suggestion only; control = cryptographic control proof, silent on identity; non = corroboration only."@en .

cp:DesignationNodeShape
    a sh:NodeShape ;
    rdfs:label "Designation node"@en ;
    sh:property [
        sh:path ( [ sh:inversePath obo:BFO_0000101 ] cco:ont00001765 ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:message "A designation shall have exactly one text value, held by its carrier (is carrier of)."@en ;
    ] .

cp:DesignatedSubjectShape
    a sh:NodeShape ;
    rdfs:label "Designated subject"@en ;
    sh:targetSubjectsOf cco:ont00001879 ;
    sh:property [
        sh:path cco:ont00001879 ;
        sh:node cp:DesignationNodeShape ;
        sh:message "Every value of designated-by shall be a well-formed designation node."@en ;
    ] .

cp:CalendarDateNodeShape
    a sh:NodeShape ;
    rdfs:label "Calendar date node"@en ;
    sh:targetClass cco:ont00001340 ;
    sh:property [
        sh:path ( [ sh:inversePath obo:BFO_0000101 ] cco:ont00001765 ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:message "A calendar date value shall be a typed xsd:date literal."@en ;
    ] .


cp:MeasurementNodeShape
    a sh:NodeShape ;
    rdfs:label "Measurement node"@en ;
    sh:targetClass cco:ont00001163 ;
    sh:xone (
        [ sh:path ( [ sh:inversePath obo:BFO_0000101 ] cco:ont00001769 ) ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:datatype xsd:decimal ]
        [ sh:path ( [ sh:inversePath obo:BFO_0000101 ] cco:ont00001773 ) ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:datatype xsd:integer ]
    ) ;
    sh:message "A measurement shall have exactly one value, held by its carrier: either one xsd:decimal (has decimal value) or one xsd:integer (has integer value), not both."@en ;
    sh:property [
        sh:path ( [ sh:inversePath obo:BFO_0000101 ] cco:ont00001863 ) ;
        sh:minCount 1 ;
        sh:message "A measurement's carrier shall reference a measurement unit."@en ;
    ] .

cp:SCtopicShape
    a sh:NodeShape ;
    rdfs:label "Subject-claimant topic"@en ;
    sh:targetClass cco-s:SubjectClaimGraph ;
    sh:property [
        sh:path cco-s:claimant ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "A SubjectClaimGraph shall have exactly one claimant."@en ;
    ] ;
    sh:property [
        sh:path cco-s:subject ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "A SubjectClaimGraph shall have at least one subject."@en ;
    ] .

cp:IdentifierStrengthShape
    a sh:NodeShape ;
    rdfs:label "Identifier-strength declaration"@en ;
    sh:targetSubjectsOf cp:identifierStrength ;
    sh:property [
        sh:path cp:identifierStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "strong" "weak" "control" "non" ) ;
        sh:message "identifierStrength shall be exactly one of: strong, weak, control, non."@en ;
    ] .